<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Mastermind.BusinessLogic\Mastermind.BusinessLogic.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Configuración dinámica: se copian a la carpeta de salida y se leen al iniciar. -->
    <!-- PreserveNewest evita sobrescribir los usos ya consumidos de cheatcodes.json. -->
    <None Update="configuracion-colores.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="cheatcodes.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
